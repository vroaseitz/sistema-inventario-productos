# Copia este archivo como .env y completa los valores reales. NUNCA subas .env al repo.
#
# Conexion a Supabase (PostgreSQL). Usa el POOLER, no el puerto 5432 directo:
# Supabase depreco la conexion directa por IPv4. Session mode = 5432, Transaction mode = 6543.
# Formato: postgresql://usuario:password@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Ruta de la base local SQLite (espejo offline). Por defecto se crea junto al ejecutable.
POS_SQLITE_PATH=pos_local.db
