# Copia este archivo como .env y completa los valores reales. NUNCA subas .env al repo.
#
# Conexion a Supabase (PostgreSQL) por el SESSION POOLER (IPv4, puerto 5432). La conexion
# directa es solo IPv6 y el PC del local (Windows 8.1) no la puede usar.
#
# Donde sacarla: Supabase -> proyecto -> boton "Connect" -> "Direct" -> metodo
# "Session pooler" -> URI. Supabase NO muestra la contrasena: usa la de la base (la
# definio quien creo el proyecto). Si tiene caracteres especiales, codificala en
# porcentaje (@ -> %40, # -> %23, etc.).
#
# Proyecto del equipo (Emporio, us-east-2):
#   host:    aws-1-us-east-2.pooler.supabase.com
#   usuario: postgres.ajdjoofmioijvmyloeqz
SUPABASE_DB_URL=postgresql://postgres.ajdjoofmioijvmyloeqz:<PASSWORD>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Ruta de la base local SQLite (espejo offline). Por defecto se crea junto al ejecutable.
POS_SQLITE_PATH=pos_local.db
